{
  "swagger": "2.0",
  "info": {
    "title": "api/device_config_store.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "DeviceConfigStoreService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/device_config_stores": {
      "get": {
        "summary": "List DevEUIs of devices having configuration store.",
        "operationId": "DeviceConfigStoreService_List",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/apiListDeviceConfigStoresResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "Max number of chmasks to return in the result-set.\nIf not set, it will be treated as 0, and the response will only return the total_count.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "offset",
            "description": "Offset in the result-set (for pagination).",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "applicationId",
            "description": "Application ID (UUID) to filter devices on.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "DeviceConfigStoreService"
        ]
      }
    },
    "/api/device_config_stores/{devEui}": {
      "get": {
        "summary": "Get returns the configuration store for the given DevEUI.",
        "operationId": "DeviceConfigStoreService_Get",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/apiGetDeviceConfigStoreResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "devEui",
            "description": "Device EUI (EUI64).",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DeviceConfigStoreService"
        ]
      },
      "delete": {
        "summary": "Delete removes the configuration store for the device.\nNote: Configurations fall back to the regional default / ADR.",
        "operationId": "DeviceConfigStoreService_Delete",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "devEui",
            "description": "Device EUI (EUI64).",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DeviceConfigStoreService"
        ]
      },
      "put": {
        "summary": "Set configuration store for the device (i.e., Upsert).",
        "operationId": "DeviceConfigStoreService_Set",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "devEui",
            "description": "Device EUI (EUI64).",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "deviceConfigStore": {
                  "$ref": "#/definitions/apiDeviceConfigStore",
                  "description": "Object to set."
                }
              }
            }
          }
        ],
        "tags": [
          "DeviceConfigStoreService"
        ]
      }
    },
    "/api/device_config_stores/{devEui}/alignment": {
      "get": {
        "summary": "Returns the device's alignment status for stored configurations\n(whether they have been sent to and acknowledged by the device).",
        "operationId": "DeviceConfigStoreService_GetDeviceConfigAlignment",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/apiGetDeviceConfigAlignmentResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "devEui",
            "description": "Device EUI (EUI64).",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DeviceConfigStoreService"
        ]
      }
    },
    "/api/device_config_stores/{devEui}/device_current_config": {
      "get": {
        "summary": "Get the MAC layer transmission parameters currently in use by the given device as far\nas the server knows, based on most recent transmissions and MAC command acknowledgments.\nNote: Params may not yet be aligned with the ones set in the device's config store.",
        "operationId": "DeviceConfigStoreService_GetDeviceCurrentParams",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/apiGetDeviceCurrentParamsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "devEui",
            "description": "Device EUI (EUI64).",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DeviceConfigStoreService"
        ]
      }
    }
  },
  "definitions": {
    "apiDeviceConfigStore": {
      "type": "object",
      "properties": {
        "enabledUplinkChannelIndices": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "title": "Enabled uplink channel indices in the channel mask.\n(missing channels are disabled)"
        },
        "dr": {
          "type": "integer",
          "format": "int64",
          "description": "Data-rate."
        },
        "txPowerIndex": {
          "type": "integer",
          "format": "int64",
          "description": "Transmission power index."
        },
        "nbTrans": {
          "type": "integer",
          "format": "int64",
          "description": "Number of transmissions."
        },
        "maxDutyCycle": {
          "type": "integer",
          "format": "int64",
          "description": "Maximum duty-cycle."
        }
      }
    },
    "apiDeviceConfigStoreListItem": {
      "type": "object",
      "properties": {
        "devEui": {
          "type": "string",
          "description": "Device EUI (EUI64)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Created at timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      }
    },
    "apiDeviceUplinkChannel": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "integer",
          "format": "int64",
          "description": "Frequency Hz."
        },
        "dataRates": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "description": "Available data-rates."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this channel is enabled on the device."
        },
        "userDefined": {
          "type": "boolean",
          "description": "Whether this channel is not among regional defaults."
        }
      }
    },
    "apiGetDeviceConfigAlignmentResponse": {
      "type": "object",
      "properties": {
        "enabledUplinkChannelIndices": {
          "type": "boolean",
          "description": "Alignment of the mask of enabled uplink channels."
        },
        "dr": {
          "type": "boolean",
          "description": "Alignment of the data-rate."
        },
        "txPowerIndex": {
          "type": "boolean",
          "description": "Alignment of the transmission power index."
        },
        "nbTrans": {
          "type": "boolean",
          "description": "Alignment of the number of transmissions."
        },
        "maxDutyCycle": {
          "type": "boolean",
          "description": "Alignment of the maximum duty-cycle."
        }
      }
    },
    "apiGetDeviceConfigStoreResponse": {
      "type": "object",
      "properties": {
        "deviceConfigStore": {
          "$ref": "#/definitions/apiDeviceConfigStore",
          "description": "Device configuration store object."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Created at timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      }
    },
    "apiGetDeviceCurrentParamsResponse": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/apiDeviceUplinkChannel"
          },
          "description": "Uplink channels currently available to the device."
        },
        "dr": {
          "type": "integer",
          "format": "int64",
          "description": "Data-rate."
        },
        "txPowerIndex": {
          "type": "integer",
          "format": "int64",
          "description": "Transmission power index."
        },
        "nbTrans": {
          "type": "integer",
          "format": "int64",
          "description": "Number of transmissions."
        },
        "maxDutyCycle": {
          "type": "integer",
          "format": "int64",
          "description": "Maximum duty-cycle."
        }
      }
    },
    "apiListDeviceConfigStoresResponse": {
      "type": "object",
      "properties": {
        "totalCount": {
          "type": "integer",
          "format": "int64",
          "description": "Total number of configuration stores."
        },
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/apiDeviceConfigStoreListItem"
          },
          "description": "Result-set."
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  }
}
